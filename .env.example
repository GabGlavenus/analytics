# Conexão com o banco do CRM (use, de preferência, um usuário com permissão apenas de SELECT)
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_leitura
DB_PASSWORD=
DB_NAME=crmdb

# Fuso em que o banco GRAVA as datas (o crmdb grava em UTC)
DB_TIMEZONE=+00:00

# Fuso usado para exibir as datas e definir os limites do período (Brasília)
APP_TIMEZONE=-03:00

# Servidor web
PORT=3000
HOST=127.0.0.1
